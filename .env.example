# Copy to .env on the server and fill in real values. .env is gitignored.
#
# Generate SECRET_KEY_BASE once with:
#   docker run --rm -e RAILS_ENV=production <image> bundle exec rails secret

# --- Rails ---
RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true
SECRET_KEY_BASE=

# --- Database (RDS endpoint) ---
DB_HOST=
DB_DATABASE=app_production
DB_USERNAME=
DB_PASSWORD=

# --- Mail (Gmail SMTP) ---
# Used by Devise password reset (:recoverable) and the inquiry form.
# The app still boots without these, but those two features will error on send.
SEND_MAIL=
SEND_MAIL_PASSWORD=
